{
  "name": "telegram-utils",
  "version": "0.3.0",
  "description": "Read, archive and send your own Telegram from the command line or an agent",
  "keywords": [
    "telegram",
    "mtproto",
    "mtcute",
    "export",
    "markdown",
    "cli",
    "archive",
    "agent"
  ],
  "homepage": "https://github.com/qwadratic/telegram-utils#readme",
  "bugs": {
    "url": "https://github.com/qwadratic/telegram-utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwadratic/telegram-utils.git"
  },
  "license": "ISC",
  "author": "qwadratic",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "telegram-utils": "bin/tgu.mjs",
    "tgu": "bin/tgu.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --trace-warnings src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "coverage": "rm -rf coverage && npx c8 tsx --test",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@mtcute/core": "^0.27.8",
    "@mtcute/node": "^0.27.8",
    "better-sqlite3-multiple-ciphers": "^12.6.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
