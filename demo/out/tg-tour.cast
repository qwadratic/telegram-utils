{"version":3,"term":{"cols":96,"rows":30,"type":"xterm-256color"},"timestamp":1787042091,"command":"bash /Users/gerhardgustav/Desktop/hobby-dev/telegram-utils/demo/tour.sh","env":{"SHELL":"/bin/zsh"}}
[0.058, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.001, "o", "\u001b[1mtg\u001b[0m - your own Telegram, from the command line.\r\n"]
[1.012, "o", "\u001b[2m# One binary, two audiences: a person at a terminal, and a coding agent.\u001b[0m\r\n"]
[1.012, "o", "\u001b[2m# Everything below is real output against a synthetic workspace.\u001b[0m\r\n"]
[1.619, "o", "\r\n\u001b[1mPart 1 - a person\u001b[0m\r\n"]
[0.005, "o", "\u001b[2m─────────────────\u001b[0m\r\n"]
[1.214, "o", "\u001b[2m# One command answers 'can I use this right now?'\u001b[0m\r\n"]
[1.010, "o", "\u001b[36m$\u001b[0m tg doctor\r\n"]
[1.870, "o", "\u001b[33m/private/tmp/tg-demo/data\u001b[39m\r\n\u001b[33m  ok    psst                  on PATH\u001b[39m\r\n\u001b[33m  ok    api-credentials       API_ID and API_HASH resolve\u001b[39m\r\n\u001b[33m  FAIL  session               no session in the vault and no local cache\u001b[39m\r\n\u001b[33m        -> tg session login\u001b[39m\r\n\u001b[33m  ok    lock                  free\u001b[39m\r\n\u001b[33m  ok    data-dir-permissions  0700\u001b[39m\r\n\u001b[33m  ok    archive-permissions   0700\u001b[39m\r\n\u001b[33m  FAIL  liveness              not checked: there is no session to check\u001b[39m\r\n\u001b[33m        -> tg session login\u001b[39m\r\n\u001b[33m\u001b[39m\r\n\u001b[33mNOT ready: a human has to log in at a terminal.\u001b[39m\r\n\u001b[33mNext:  tg session login\u001b[39m\r\n\u001b[33m\u001b[39m"]
[0.016, "o", "\r\n"]
[1.312, "o", "\u001b[2m# It names the one thing it cannot do for you, and what to type.\u001b[0m\r\n"]
[1.823, "o", "\u001b[2m# Local state, read straight off disk. No network, no lock.\u001b[0m\r\n"]
[1.014, "o", "\u001b[36m$\u001b[0m tg folders list\r\n"]
[1.567, "o", "\u001b[2mfolder        chats   synced  last updated\u001b[22m\r\n"]
[0.001, "o", "Engineering       3       3  12m ago\r\nDesign            2       2  5h ago\r\n"]
[0.000, "o", "Reading List      1       1  4d ago\r\n"]
[0.000, "o", "Archive 2025      1       0  \u001b[33mnever\u001b[39m\r\n"]
[0.022, "o", "\r\n"]
[1.311, "o", "\u001b[2m# A chat can be named four ways: id, @username, t.me link, or 'me'.\u001b[0m\r\n"]
[1.014, "o", "\u001b[2m# This one is a Cyrillic lookalike, refused before any network call.\u001b[0m\r\n"]
[1.005, "o", "\u001b[36m$\u001b[0m tg dump '@durоv' 2>&1 | head -3\r\n"]
[1.398, "o", "Error: Cannot use \"@durоv\" as a chat: it contains a non-ASCII character, and Telegram usernames are ASCII only. If you copied this from a message it may be a lookalike\r\n  Accepted forms:\r\n    108844221            a numeric id (from `tg peers find <name>`)\r\n"]
[0.019, "o", "\r\n"]
[1.306, "o", "\u001b[2m# Telegram usernames are ASCII, so that is not a near-miss handle.\u001b[0m\r\n"]
[1.012, "o", "\u001b[2m# It is not a valid handle at all.\u001b[0m\r\n"]
[1.912, "o", "\r\n\u001b[1mPart 2 - a coding agent\u001b[0m\r\n"]
[0.006, "o", "\u001b[2m───────────────────────\u001b[0m\r\n"]
[1.207, "o", "\u001b[2m# An agent reads one file and knows the whole contract.\u001b[0m\r\n"]
[1.010, "o", "\u001b[36m$\u001b[0m head -14 SKILL.md\r\n"]
[0.509, "o", "---\r\nname: tg\r\nversion: 1.0.0\r\ndescription: Read, search and archive the operator's own Telegram from the command line, and feed it into a gbrain knowledge base. Use when the user asks to find, read, export or search their Telegram messages, chats, files or photos, or to send a message as themselves.\r\ntriggers:\r\n  - search my telegram\r\n  - read my chat history\r\n  - find a chat / find someone on telegram\r\n  - export telegram chats\r\n  - what did we discuss with\r\n  - send a telegram message\r\n  - pull a file or photo from telegram\r\n  - ingest telegram into gbrain\r\nallowed-tools:\r\n"]
[0.001, "o", "\r\n"]
[1.306, "o", "\u001b[2m# Same question as before, machine-readable.\u001b[0m\r\n"]
[1.006, "o", "\u001b[36m$\u001b[0m tg doctor --json | jq -c '{ok, status}'\r\n"]
[1.523, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"ok\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"needs_human_login\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.012, "o", "\r\n"]
[1.306, "o", "\u001b[2m# It branches on the exit code, never on the prose.\u001b[0m\r\n"]
[1.016, "o", "\u001b[36m$\u001b[0m tg doctor >/dev/null 2>&1; echo \"exit=$?  -> 3 = only a human can fix this\"\r\n"]
[1.656, "o", "exit=3  -> 3 = only a human can fix this\r\n\r\n"]
[1.313, "o", "\u001b[2m# Every read verb has the same shape.\u001b[0m\r\n"]
[1.005, "o", "\u001b[36m$\u001b[0m tg folders list --json | jq -c '.[] | {title, chatCount}'\r\n"]
[1.424, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Engineering\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Design\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Reading List\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Archive 2025\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.022, "o", "\r\n"]
[1.309, "o", "\u001b[2m# Failures come back as JSON on stdout, carrying the same code.\u001b[0m\r\n"]
[1.013, "o", "\u001b[36m$\u001b[0m tg dump 'has space' --json 2>/dev/null | jq -c '.error | {code, exit}'\r\n"]
[1.318, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"usage\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"exit\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.015, "o", "\r\n"]
[1.308, "o", "\u001b[2m# A typo is exit 2, not exit 1. Exit 1 would mean a bug in tg.\u001b[0m\r\n"]
[1.010, "o", "\u001b[36m$\u001b[0m tg peers frobnicate >/dev/null 2>&1; echo \"exit=$?\"\r\n"]
[1.556, "o", "exit=2\r\n\r\n"]
[1.312, "o", "\u001b[2m# And the line an agent does not cross:\u001b[0m\r\n"]
[1.019, "o", "\u001b[36m$\u001b[0m TG_NON_INTERACTIVE=1 tg send text 4820000 'ping' --json 2>/dev/null | jq -r '.error.detail'\r\n"]
[1.382, "o", "Refusing to send from a non-interactive run without --yes.\r\n  This run cannot ask anyone, and sending is not reversible.\r\n  --yes is the operator stating an unattended send is intended. If you are\r\n  an agent and no one told you to send, stop here and ask them.\r\n"]
[0.012, "o", "\r\n"]
[1.311, "o", "\u001b[2m# Exit 3 again: stop and ask the operator. Not a puzzle to route around.\u001b[0m\r\n"]
[1.014, "o", "\u001b[2m# It costs nothing either - refused before any session is opened.\u001b[0m\r\n"]
[1.016, "o", "\u001b[36m$\u001b[0m ls data/session.lock 2>/dev/null || echo 'no lock was ever taken'\r\n"]
[0.519, "o", "no lock was ever taken\r\n\r\n"]
[1.307, "o", "\r\n\u001b[1mThe payoff\u001b[0m\r\n"]
[0.004, "o", "\u001b[2m──────────\u001b[0m\r\n"]
[1.213, "o", "\u001b[2m# Archive pages feed a gbrain knowledge base...\u001b[0m\r\n"]
[1.009, "o", "\u001b[2m# ...then you ask in your own words, not in grep.\u001b[0m\r\n"]
[1.013, "o", "\u001b[36m$\u001b[0m tg ship --skip-unroutable && gbrain query \"who offered me a job\"\r\n"]
[2.413, "o", "\r\n\u001b[1mnpm install -g @qwadratic/tg\u001b[0m\r\n"]
[2.512, "x", "0"]
