{"version":3,"term":{"cols":96,"rows":30,"type":"xterm-256color"},"timestamp":1787038989,"command":"bash /Users/gerhardgustav/Desktop/hobby-dev/telegram-utils/demo/tour.sh","env":{"SHELL":"/bin/zsh"}}
[0.028, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.001, "o", "\u001b[2m# tg — read, search and archive your own Telegram. Built for agents.\u001b[0m\r\n"]
[1.520, "o", "\u001b[2m# One command answers 'will an unattended run work right now?'\u001b[0m\r\n"]
[1.109, "o", "\u001b[36m$\u001b[0m tg doctor --offline\r\n"]
[1.808, "o", "\u001b[33m/Users/gerhardgustav/Desktop/hobby-dev/telegram-utils/demo/workspace/data\u001b[39m\r\n\u001b[33m  ok    psst                  on PATH\u001b[39m\r\n\u001b[33m  ok    api-credentials       API_ID and API_HASH resolve\u001b[39m\r\n\u001b[33m  FAIL  session               no session in the vault and no local cache\u001b[39m\r\n\u001b[33m        -> tg session login\u001b[39m\r\n\u001b[33m  ok    lock                  free\u001b[39m\r\n\u001b[33m  warn  data-dir-permissions  755, readable beyond you\u001b[39m\r\n\u001b[33m        -> chmod 700 data\u001b[39m\r\n\u001b[33m  warn  archive-permissions   755, readable beyond you\u001b[39m\r\n\u001b[33m        -> chmod 700 data/archive\u001b[39m\r\n\u001b[33m\u001b[39m\r\n\u001b[33mNOT ready: a human has to log in at a terminal.\u001b[39m\r\n\u001b[33mNext:  tg session login\u001b[39m\r\n\u001b[33m\u001b[39m"]
[0.015, "o", "\r\n"]
[1.507, "o", "\u001b[2m# It is honest about what is missing, and exits 3: only a human can log in.\u001b[0m\r\n"]
[1.105, "o", "\u001b[36m$\u001b[0m tg doctor --offline >/dev/null 2>&1; echo \"exit=$?\"\r\n"]
[1.639, "o", "exit=3\r\n\r\n"]
[1.509, "o", "\u001b[2m# A chat can be named four ways: id, @username, t.me link, or 'me'.\u001b[0m\r\n"]
[1.109, "o", "\u001b[2m# Lookalike handles are refused before any network call.\u001b[0m\r\n"]
[1.109, "o", "\u001b[36m$\u001b[0m tg dump '@durоv' 2>&1 | head -3\r\n"]
[1.488, "o", "Error: Cannot use \"@durоv\" as a chat: it contains a non-ASCII character, and Telegram usernames are ASCII only. If you copied this from a message it may be a lookalike\r\n  Accepted forms:\r\n    108844221            a numeric id (from `tg peers find <name>`)\r\n"]
[0.015, "o", "\r\n"]
[1.510, "o", "\u001b[2m# Telegram usernames are ASCII, so that Cyrillic 'o' is not a near-miss.\u001b[0m\r\n"]
[1.112, "o", "\u001b[2m# It is not a valid username at all.\u001b[0m\r\n"]
[1.919, "o", "\u001b[2m# Bad arguments are exit 2 (usage), not 4 (misconfigured). Agents can tell.\u001b[0m\r\n"]
[1.109, "o", "\u001b[36m$\u001b[0m tg dump 'has space' >/dev/null 2>&1; echo \"exit=$?\"\r\n"]
[1.535, "o", "exit=2\r\n\r\n"]
[1.509, "o", "\u001b[2m# With --json, failures come back as JSON on stdout too.\u001b[0m\r\n"]
[1.107, "o", "\u001b[36m$\u001b[0m tg dump 'has space' --json 2>/dev/null | head -7\r\n"]
[1.323, "o", "{\r\n  \"ok\": false,\r\n  \"error\": {\r\n    \"code\": \"usage\",\r\n    \"exit\": 2,\r\n    \"message\": \"Cannot use \\\"has space\\\" as a chat: it is not a numeric id and not a valid username\",\r\n    \"detail\": \"Cannot use \\\"has space\\\" as a chat: it is not a numeric id and not a valid username\\n  Accepted forms:\\n    108844221            a numeric id (from `tg peers find <name>`)\\n    @durov               a username\\n    https://t.me/durov   a public link\\n    me                   your own Saved Messages\"\r\n"]
[0.013, "o", "\r\n"]
[1.510, "o", "\u001b[2m# Real state, read straight off disk. No network, no lock.\u001b[0m\r\n"]
[1.109, "o", "\u001b[36m$\u001b[0m tg folders list\r\n"]
[1.380, "o", "\u001b[2mfolder        chats   synced  last updated\u001b[22m\r\n"]
[0.001, "o", "Engineering       3       3  12m ago\r\nDesign            2       2  5h ago\r\nReading List      1       1  4d ago\r\n"]
[0.000, "o", "Archive 2025      1       0  \u001b[33mnever\u001b[39m\r\n"]
[0.021, "o", "\r\n"]
[1.505, "o", "\u001b[2m# Same view for a script or an agent.\u001b[0m\r\n"]
[1.107, "o", "\u001b[36m$\u001b[0m tg folders list --json | jq -c '.[] | {title, chatCount, lastUpdated}'\r\n"]
[1.380, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Engineering\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"lastUpdated\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-08-18T07:31:08.254Z\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Design\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"lastUpdated\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-08-18T02:23:08.254Z\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Reading List\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"lastUpdated\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-08-14T07:43:08.254Z\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Archive 2025\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"chatCount\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"lastUpdated\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.023, "o", "\r\n"]
[1.507, "o", "\u001b[2m# Only one client may hold a session: two corrupt Telegram's message state.\u001b[0m\r\n"]
[1.109, "o", "\u001b[36m$\u001b[0m sleep 30 & echo $! > data/session.lock; tg folders update --folder 2 2>&1 | head -3\r\n"]
[2.493, "o", "Error: Another tg instance is already running (pid 86848).\r\n  Two clients sharing one Telegram session corrupt the message-box state and\r\n  can get the session revoked, so this run was refused.\r\n"]
[0.015, "o", "\r\n"]
[1.512, "o", "\u001b[2m# The full surface.\u001b[0m\r\n"]
[1.108, "o", "\u001b[36m$\u001b[0m tg --help | sed -n '/Commands:/,$p' | head -20\r\n"]
[1.383, "o", "Commands:\r\n  init [options]                   Make the current directory a tg workspace\r\n                                   with its own session\r\n  doctor [options]                 Check whether unattended runs will work, and\r\n                                   say what to fix\r\n  auth [options]                   Authenticate with Telegram (alias for\r\n                                   \"session login\")\r\n  session                          Manage the Telegram session stored in psst\r\n  setup [options]                  Select Telegram folders to export\r\n  folders                          Inspect and update the folders already synced\r\n  peers                            Find chats and their numeric ids\r\n  dump [options] <peer>            Print one chat as a flat chronological\r\n                                   transcript (id, @username, t.me link or me)\r\n  media                            Download media out of a chat\r\n  watch [options] [peer]           Wait for new media in a chat (default: your\r\n                  "]
[0.000, "o", "                 Saved Messages) and download it\r\n  export                           Export chats from tracked folders\r\n  check-phones [options] <phones>  Check phone numbers via contacts import,\r\n                                   output CSV to stdout\r\n  ship [options]                   OPTIONAL: push new archive files into gbrain,\r\n"]
[0.000, "o", "\r\n"]
[1.510, "o", "\u001b[2m# Archive pages feed a gbrain knowledge base, then you ask in your own words.\u001b[0m\r\n"]
[1.108, "o", "\u001b[36m$\u001b[0m tg ship --skip-unroutable && gbrain query \"who offered me a job\"\r\n"]
[2.209, "o", "\r\n\u001b[2m# npm install -g @qwadratic/tg\u001b[0m\r\n"]
[3.621, "x", "0"]
